# Server-side Alpaca keys. Never prefix these with VITE_.
# Paper-trading keys work for the market-data endpoints and the paper account integration.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Use https://paper-api.alpaca.markets when the key pair is for paper trading.
ALPACA_TRADING_API_URL=https://paper-api.alpaca.markets

# IEX is available on Alpaca's Basic market-data plan.
ALPACA_DATA_FEED=iex

# ETF constituents are served keylessly by TickerInside and cached on the server.
# TICKERINSIDE_BASE_URL=https://tickerinside.com/api/v1

# Optional rolling history dates. End defaults to yesterday.
# ALPACA_HISTORY_START=2021-11-01
# ALPACA_HISTORY_END=2026-11-01

# Optional compatible endpoint overrides.
# ALPACA_DATA_URL=https://data.alpaca.markets
# VITE_MARKET_DATA_ENDPOINT=/api/market-data

# Legacy names accepted by the paper-trading endpoint and seed script.
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=
