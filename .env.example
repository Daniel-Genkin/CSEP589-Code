# "mock" serves every request from src/api/mock (no backend needed).
# "http" sends requests to VITE_API_BASE_URL using the same endpoints.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api

# Dev-server proxy target for /api when VITE_API_MODE=http
API_PROXY_TARGET=http://localhost:8080

# App store listings linked from the website (the buttons fall back to the store home pages)
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=
